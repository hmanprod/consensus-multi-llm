# Providers (au moins une clé est requise pour lancer des analyses)
# Tant qu'un provider utilisé par la configuration active n'a pas de clé,
# les analyses sont bloquées dans l'interface.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
KIMI_API_KEY=
GLM_API_KEY=
XAI_API_KEY=
MODEL_API_KEY=
OPENROUTER_API_KEY=

# Clé de chiffrement des credentials (obligatoire pour enregistrer des clés API)
# Génération : openssl rand -hex 32
ENCRYPTION_KEY=

# PostgreSQL Neon (Phase 2)
DATABASE_URL=

# Clerk (auth) — obligatoire : l'application exige une authentification
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_SIGN_IN_URL=/sign-in
CLERK_SIGN_UP_URL=/sign-up
CLERK_AFTER_SIGN_IN_URL=/
CLERK_AFTER_SIGN_UP_URL=/

# URL publique de l'app (utilisée par OpenRouter)
NEXT_PUBLIC_APP_URL=http://localhost:3000